<%- include('partials/header') %>
<h1>Coach dashboard</h1>
<% if (!profile.school) { %>
  <p class="flash">Add your school and program on <a href="/profile/edit">My program</a> so athletes know who's reaching out.</p>
<% } %>
<div class="actions">
  <a class="btn" href="/athletes<%= profile.sport ? '?sport=' + encodeURIComponent(profile.sport) : '' %>">Browse athletes</a>
  <% if (profile.team_id) { %>
    <a class="btn btn-secondary" href="/teams/<%= profile.team_id %>">Your team page</a>
    <a class="btn btn-secondary" href="/posts/new">New team post</a>
  <% } %>
</div>

<h2>Your visit requests</h2>
<% if (!requests.length) { %>
  <p class="muted">You haven't sent any visit requests yet.</p>
<% } else { %>
  <table class="table">
    <thead><tr><th>Athlete</th><th>Sport / position</th><th>Class</th><th>Proposed</th><th>Status</th></tr></thead>
    <tbody>
      <% requests.forEach(function (r) { %>
        <tr>
          <td><a href="/athletes/<%= r.athlete_id %>"><%= r.athlete_name %></a></td>
          <td><%= [r.sport, r.position].filter(Boolean).join(' / ') %></td>
          <td><%= r.grad_year || '' %></td>
          <td><%= r.proposed_date || '—' %></td>
          <td><span class="status status-<%= r.status %>"><%= r.status %></span>
            <% if (r.response_message) { %><div class="small muted">“<%= r.response_message %>”</div><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('partials/footer') %>

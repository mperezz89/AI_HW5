<%- include('partials/header') %>
<h1>Coach dashboard</h1>
<section class="card">
  <div class="request-head">
    <div>
      <h2 class="flush">Your coach profile</h2>
      <p class="muted small">
        <%= [profile.title, profile.school, profile.sport, profile.team_code && ('Team ID ' + profile.team_code)].filter(Boolean).join(' · ') || 'Not filled in yet' %>
      </p>
    </div>
    <div class="actions flush">
      <a class="btn btn-secondary btn-small" href="/coaches/<%= currentUser.id %>">View</a>
      <a class="btn btn-small" href="/profile/edit">Edit</a>
    </div>
  </div>
  <p class="small"><strong><%= totalFields - missing.length %> of <%= totalFields %></strong> profile fields complete</p>
  <% if (missing.length) { %>
    <p class="small muted">Still missing:</p>
    <ul class="checklist small">
      <% missing.forEach(function (f) { %><li><%= f.label %></li><% }) %>
    </ul>
  <% } %>
</section>
<div class="actions">
  <a class="btn" href="/calendar">Visit calendar (<%= openTimes %> open)</a>
  <a class="btn btn-secondary" href="/athletes<%= profile.sport ? '?sport=' + encodeURIComponent(profile.sport) : '' %>">Browse athletes</a>
  <% if (profile.team_id) { %>
    <a class="btn btn-secondary" href="/teams/<%= profile.team_id %>">Your team page</a>
    <a class="btn btn-secondary" href="/posts/new">New team post</a>
  <% } %>
</div>

<h2>Visit invitations</h2>
<% if (!requests.length) { %>
  <p class="muted">You haven't opened your calendar to any athletes yet. Add open times to <a href="/calendar">your visit calendar</a>, then open it to athletes by their Athlete ID.</p>
<% } else { %>
  <table class="table">
    <thead><tr><th>Athlete</th><th>Sport / position</th><th>Class</th><th>Visit time</th><th>Status</th></tr></thead>
    <tbody>
      <% requests.forEach(function (r) { %>
        <tr>
          <td><a href="/athletes/<%= r.athlete_id %>"><%= r.athlete_name %></a></td>
          <td><%= [r.sport, r.position].filter(Boolean).join(' / ') %></td>
          <td><%= r.grad_year || '' %></td>
          <td><%= r.starts_at ? formatSlot(r.starts_at, r.duration_minutes) : '—' %></td>
          <td><span class="status status-<%= r.status %>"><%= r.status === 'accepted' && r.starts_at ? 'Scheduled' : r.status === 'pending' ? 'Invited' : r.status %></span>
            <% if (r.response_message) { %><div class="small muted">“<%= r.response_message %>”</div><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include('partials/footer') %>

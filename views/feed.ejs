<%- include('partials/header') %>
<div class="feed-layout">
  <section class="feed">
    <nav class="tabs">
      <a href="/feed?tab=following" class="<%= tab === 'following' ? 'active' : '' %>">Following</a>
      <a href="/feed?tab=discover" class="<%= tab === 'discover' ? 'active' : '' %>">Discover</a>
    </nav>
    <% if (tab === 'discover') { %>
      <form method="get" action="/feed" class="sport-filter">
        <input type="hidden" name="tab" value="discover">
        <label class="small muted">Sport
          <select name="sport" onchange="this.form.submit()">
            <option value="all">All sports</option>
            <% SPORTS.forEach(function (s) { %><option <%= sport === s ? 'selected' : '' %>><%= s %></option><% }) %>
          </select>
        </label>
        <noscript><button class="btn btn-small">Go</button></noscript>
      </form>
    <% } %>

    <% if (!items.length) { %>
      <div class="card empty">
        <% if (tab === 'following' && !followingCount) { %>
          <p>You're not following anyone yet. Follow teams, coaches, and athletes to fill your feed.</p>
          <p class="actions" style="justify-content: center">
            <% if (isAthlete) { %><a class="btn" href="/teams">Find teams</a><% } %>
            <a class="btn btn-secondary" href="/athletes">Find athletes</a>
          </p>
        <% } else if (tab === 'following') { %>
          <p>Nothing new from the people and teams you follow. Check <a href="/feed?tab=discover">Discover</a> for more.</p>
        <% } else { %>
          <p>No team posts<%= sport ? ' for ' + sport : '' %> yet.<% if (sport) { %> <a href="/feed?tab=discover&sport=all">See all sports</a>.<% } %></p>
        <% } %>
      </div>
    <% } %>

    <% items.forEach(function (item) { %>
      <% if (item.kind === 'post') { %>
        <%- include('partials/post-card', { post: item, back: back }) %>
      <% } else { %>
        <%- include('partials/highlight-card', { video: item }) %>
      <% } %>
    <% }) %>

    <% if (nextPage) { %><p class="center"><a class="btn btn-secondary" href="<%= nextPage %>">Load more</a></p><% } %>
  </section>

  <% if (isAthlete) { %>
  <aside class="feed-side<%= followingCount ? '' : ' prominent' %>">
    <div class="card">
      <h2 class="side-title">Teams you might like</h2>
      <% if (!suggestions.length) { %><p class="muted small">You're following every team so far.</p><% } %>
      <% suggestions.forEach(function (t) { %>
        <div class="suggestion">
          <a class="team-avatar" href="/teams/<%= t.id %>" aria-hidden="true"><%= t.school.trim().charAt(0).toUpperCase() %></a>
          <div class="grow">
            <a href="/teams/<%= t.id %>" class="post-team"><%= t.school %></a>
            <div class="muted small"><%= t.sport %> · <%= t.followers %> follower<%= t.followers === 1 ? '' : 's' %></div>
          </div>
          <form method="post" action="/teams/<%= t.id %>/follow" class="inline">
            <input type="hidden" name="back" value="/feed?tab=<%= tab %>">
            <button class="btn btn-small">Follow</button>
          </form>
        </div>
      <% }) %>
      <p class="small"><a href="/teams">Browse all teams</a></p>
    </div>
  </aside>
  <% } %>
</div>
<%- include('partials/footer') %>

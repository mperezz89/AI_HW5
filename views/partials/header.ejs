<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Highlight Reel</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Highlight<span>Reel</span></a>
  <nav>
    <% if (currentUser) { %>
      <% if (currentUser.role === 'athlete') { %>
        <a href="/feed">Feed</a>
        <a href="/teams">Teams</a>
        <a href="/messages">Messages<% if (unreadMessages) { %><span class="nav-badge" aria-label="<%= unreadMessages %> unread"><%= unreadMessages %></span><% } %></a>
        <a href="/dashboard">Dashboard</a>
        <a href="/athletes/<%= currentUser.id %>">My profile</a>
        <a class="btn btn-small" href="/videos/new">Upload</a>
      <% } else { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/athletes">Find athletes</a>
        <a href="/recruiting">Recruiting</a>
        <a href="/feed">Feed</a>
        <a href="/messages">Messages<% if (unreadMessages) { %><span class="nav-badge" aria-label="<%= unreadMessages %> unread"><%= unreadMessages %></span><% } %></a>
        <a href="/calendar">Calendar</a>
        <a href="/teams/mine">My team</a>
        <a href="/coaches/<%= currentUser.id %>">My profile</a>
        <a class="btn btn-small" href="/posts/new">New post</a>
      <% } %>
      <form method="post" action="/logout" class="inline"><button class="link">Log out</button></form>
    <% } else { %>
      <a href="/login">Log in</a>
      <a class="btn btn-small" href="/register">Sign up</a>
    <% } %>
  </nav>
</header>
<main>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>

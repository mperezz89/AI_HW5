<%- include('partials/header') %>
<section class="card team-head">
  <div class="team-avatar team-avatar-lg" aria-hidden="true"><%= team.school.trim().charAt(0).toUpperCase() %></div>
  <div class="grow">
    <h1><%= team.school %></h1>
    <p class="muted"><%= [team.sport, team.division, team.team_code && ('Team ID ' + team.team_code)].filter(Boolean).join(' · ') %></p>
    <p class="team-counts"><strong><%= posts.length %></strong> post<%= posts.length === 1 ? '' : 's' %> · <strong><%= followers %></strong> follower<%= followers === 1 ? '' : 's' %></p>
    <% if (coaches.length) { %>
      <p class="small muted">Coaches:
        <% coaches.forEach(function (c, i) { %><a href="/coaches/<%= c.id %>"><%= c.name %></a><%= c.title ? ' (' + c.title + ')' : '' %><%= i < coaches.length - 1 ? ', ' : '' %><% }) %>
      </p>
    <% } %>
  </div>
  <div>
    <% if (currentUser.role === 'athlete') { %>
      <div class="actions flush">
        <form method="post" action="/teams/<%= team.id %>/follow" class="inline">
          <button class="btn<%= following ? ' btn-secondary' : '' %>"><%= following ? 'Following' : 'Follow' %></button>
        </form>
        <a class="btn btn-secondary" href="/messages/new?team=<%= team.id %>">Message team</a>
      </div>
    <% } else if (isTeamCoach) { %>
      <a class="btn" href="/posts/new">New post</a>
    <% } %>
  </div>
</section>
<% if (!posts.length) { %>
  <p class="muted"><%= isTeamCoach ? 'Your team has no posts yet. Share your first photo or video.' : 'This team has not posted yet.' %></p>
<% } %>
<div class="post-grid">
  <% posts.forEach(function (p) { %>
    <a class="post-tile" href="/posts/<%= p.id %>" title="<%= p.caption || '' %>">
      <% if (p.media_kind === 'image') { %>
        <img src="/media/<%= p.media_filename %>" alt="<%= p.caption ? p.caption.slice(0, 120) : 'Team post' %>" loading="lazy">
      <% } else { %>
        <video muted preload="metadata" playsinline><source src="/media/<%= p.media_filename %>#t=0.1" type="<%= p.mime_type %>"></video>
        <span class="tile-badge" aria-label="Video">▶</span>
      <% } %>
      <span class="tile-likes">♥ <%= p.like_count %></span>
    </a>
  <% }) %>
</div>
<%- include('partials/footer') %>
